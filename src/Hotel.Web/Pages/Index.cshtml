@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
    var roles = string.Join(", ", User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value));
}

<h1 class="h3">Inicio</h1>
<p>Sesión iniciada como <strong>@User.Identity?.Name</strong> (@roles).</p>
